# hfmt: Hornet source formatter.
#
#   hfmt                   format stdin to stdout (also `-` among the files)
#   hfmt file ...          format files in place (written only if they change)
#   hfmt --check file ...  list files that would change; exit 1 if any
#   hfmt --tokens [file]   dump the token stream
# Flags may appear anywhere among the arguments.
from 'os' import get_args, read_file, read_stdin, write_file, write_stdout, write_stderr, exit
from 'errors' import Error, StrResult, IntResult
from 'fmt' import int_to_str
from 'strings' import Builder, starts_with
from 'lexer' import lex, kind_name, LexError, Tokens, TK_NEWLINE
from 'layout' import layout, LayoutError

const str USAGE = 'usage: hfmt [--check] [file | - ...]\n       hfmt --tokens [file | -]\n'

type FormatError struct:
    str message  # path:line:col: error: ...

type FormatResult is str | FormatError

def str _located(str path, int line, int col, str message):
    return path + ':' + int_to_str(line) + ':' + int_to_str(col) + ': error: ' + message

def FormatResult format_source(str path, str src):
    match lex(src) as r:
        is LexError:
            return FormatError(_located(path, r.line, r.col, r.message))
        is Tokens:
            match layout(r.items) as f:
                is LayoutError:
                    return FormatError(_located(path, f.line, f.col, f.message))
                is str:
                    return f
    return ''

# One line per token: KIND line col text (NEWLINE shows its bracket depth instead).
def str dump_tokens(str path, str src):
    match lex(src) as r:
        is LexError:
            write_stderr(_located(path, r.line, r.col, r.message) + '\n')
            exit(1)
        is Tokens:
            Builder b
            for t in r.items:
                b.write(kind_name(t.kind))
                b.write(' ')
                b.write_int(t.line)
                b.write(' ')
                b.write_int(t.col)
                b.write(' ')
                if t.kind == TK_NEWLINE:
                    b.write_int(t.depth)
                else:
                    b.write(t.text)
                b.write('\n')
            return b.to_str()
    return ''

def StrResult _read(str path):
    if len(path) > 0:
        return read_file(path)
    return read_stdin()

def str _source_or_exit(str path):
    match _read(path) as v:
        is str:
            return v
        is Error:
            write_stderr('hfmt: ' + v.message + '\n')
            exit(1)

# Format (or check) one file; false on any error or, when checking, a needed change.
def bool _process_file(str path, bool check):
    match read_file(path) as src:
        is Error:
            write_stderr('hfmt: ' + src.message + '\n')
            return false
        is str:
            match format_source(path, src) as f:
                is FormatError:
                    write_stderr(f.message + '\n')
                    return false
                is str:
                    if f == src:
                        return true
                    if check:
                        write_stdout(path + '\n')
                        return false
                    IntResult w = write_file(path, f)
                    if w is Error:
                        write_stderr('hfmt: ' + w.message + '\n')
                        return false
                    return true
    return false

# Format (or check) standard input, writing the result to standard output.
def bool _process_stdin(bool check):
    str src = _source_or_exit('')
    match format_source('<stdin>', src) as f:
        is FormatError:
            write_stderr(f.message + '\n')
            return false
        is str:
            if check:
                if f != src:
                    write_stdout('<stdin>\n')
                    return false
                return true
            write_stdout(f)
            return true
    return false

def int main(int argc, *byte argv):
    []str args = get_args(argc, argv)
    bool tokens = false
    bool check = false
    bool stdin_named = false
    []str files
    for i, a in args:
        if i == 0:
            continue
        if a == '--tokens':
            tokens = true
        elif a == '--check':
            check = true
        elif a == '-':
            if stdin_named:
                write_stderr(USAGE)
                return 2
            stdin_named = true
            files = append(files, a)
        elif starts_with(a, '-'):
            write_stderr(USAGE)
            return 2
        else:
            files = append(files, a)
    if tokens:
        if check or len(files) > 1:
            write_stderr(USAGE)
            return 2
        str path = ''
        str label = '<stdin>'
        if len(files) == 1 and files[0] != '-':
            path = files[0]
            label = path
        write_stdout(dump_tokens(label, _source_or_exit(path)))
        return 0
    if len(files) == 0:
        files = append(files, '-')
    int status = 0
    for path in files:
        bool ok = false
        if path == '-':
            ok = _process_stdin(check)
        else:
            ok = _process_file(path, check)
        if not ok:
            status = 1
    return status
