# Indentation and spacing. Line breaks stay where they are; tokens are
# re-joined with canonical spacing and each line is re-indented.
from 'strings' import Builder, trim
from 'lexer' import Token, TK_IDENT, TK_KEYWORD, TK_NUMBER, TK_STRING, TK_BYTE, TK_OP, TK_COMMENT, TK_NEWLINE, TK_EOF

const int INDENT = 4

# One physical line.
type Line struct:
    []Token toks  # without the trailing NEWLINE
    int depth  # open brackets at the start of the line
    int width  # original indentation, in columns
    int level  # block level, for lines that start a statement
    bool blank
    bool comment_only
    bool continuation  # starts inside brackets (or with a closing bracket)

type Lines struct:
    []Line items

type LayoutError struct:
    str message
    int line
    int col

type LayoutResult is str | LayoutError

def []Line _split_lines([]Token toks):
    []Line lines = none
    []Token cur = none
    for t in toks:
        if t.kind == TK_NEWLINE or t.kind == TK_EOF:
            if t.kind == TK_EOF and len(cur) == 0:
                break
            Line l = Line(cur, t.depth, 0, 0, len(cur) == 0, false, false)
            if len(cur) > 0:
                l.depth = cur[0].depth
                l.width = cur[0].col - 1
                l.comment_only = cur[0].kind == TK_COMMENT
                l.continuation = cur[0].depth > 0 or _is_closer(cur[0])
            lines = append(lines, l)
            cur = none
        else:
            cur = append(cur, t)
    return lines

def bool _starts_statement(Line l):
    return not l.blank and not l.comment_only and not l.continuation

# Block levels from the original indentation widths, like the compiler's INDENT/DEDENT.
# Returns the index of a line whose dedent matches no outer level, or -1.
def int _assign_levels([]Line lines):
    []int stack = []int[0]
    for i, l in lines:
        if _starts_statement(l):
            int top = stack[len(stack) - 1]
            if l.width > top:
                stack = append(stack, l.width)
            while l.width < stack[len(stack) - 1]:
                stack = stack[0:len(stack) - 1]
            if l.width != stack[len(stack) - 1]:
                return i
            lines[i].level = len(stack) - 1
    # Comment-only lines outside brackets take the level of the next statement.
    int next_level = 0
    int k = len(lines) - 1
    while k >= 0:
        if _starts_statement(lines[k]):
            next_level = lines[k].level
        elif lines[k].comment_only and not lines[k].continuation:
            lines[k].level = next_level
        k -= 1
    return -1

def bool _is_type_keyword(str w):
    return w == 'int' or w == 'int8' or w == 'uint8' or w == 'int32' or w == 'int64' or w == 'byte' or w == 'str' or w == 'bool' or w == 'dict'

def bool _is_opener(Token t):
    return t.kind == TK_OP and (t.text == '(' or t.text == '[' or t.text == '{')

def bool _is_closer(Token t):
    return t.kind == TK_OP and (t.text == ')' or t.text == ']' or t.text == '}')

def bool _is_word(Token t):
    return t.kind == TK_IDENT or t.kind == TK_KEYWORD or t.kind == TK_NUMBER or t.kind == TK_STRING or t.kind == TK_BYTE

# Spacing state within one statement.
type State struct:
    bool has_prev
    Token prev
    bool prev_value  # prev ends an operand
    bool prev_unary  # prev is a unary operator
    []byte brackets  # open bracket characters
    []bool type_brackets  # parallel: '[' opened in prefix position (a type or array literal)
    bool closed_type_bracket  # prev is ']' closing a type bracket
    int count  # tokens so far in the statement
    bool type_decl  # the statement starts with 'type'
    bool decl_header  # the statement starts with 'def', 'extern', or 'intrinsic'
    int chain_groups  # consecutive type brackets in the current chain (`[2][3]` is 2)
    bool chain_empty  # the chain has a `[]`
    bool chain_decl  # the chain started where only a type can be (a declaration)

    def reset(*s):
        s.has_prev = false
        s.prev_value = false
        s.prev_unary = false
        s.brackets = none
        s.type_brackets = none
        s.closed_type_bracket = false
        s.count = 0
        s.type_decl = false
        s.decl_header = false
        s.chain_groups = 0
        s.chain_empty = false
        s.chain_decl = false

    def byte top(s):
        if len(s.brackets) == 0:
            return " "
        return s.brackets[len(s.brackets) - 1]

def bool _ends_value(Token t, bool closed_type_bracket):
    if t.kind == TK_IDENT or t.kind == TK_NUMBER or t.kind == TK_STRING or t.kind == TK_BYTE:
        return true
    if t.kind == TK_KEYWORD:
        return t.text == 'true' or t.text == 'false' or t.text == 'none'
    if t.kind == TK_OP:
        return t.text == ')' or t.text == '}' or (t.text == ']' and not closed_type_bracket)
    return false

# Whether cur is a unary operator given the previous token's state.
def bool _is_unary(Token cur, State s):
    if cur.kind != TK_OP:
        return false
    if cur.text == '~':
        return true
    if cur.text == '-' or cur.text == '*' or cur.text == '&':
        return not s.prev_value
    return false

# Whether the `*` at toks[i], after a type bracket, multiplies rather than starting a pointer type,
# following the compiler: `[x][0] * 2` and, outside declarations, `[x][0] * ys[1]` multiply (a
# pointer element type behind two or more sized dimensions can't be written in an expression).
def bool _star_multiplies([]Token toks, int i, State s):
    if i + 1 >= len(toks):
        return false
    Token n = toks[i + 1]
    if n.kind == TK_NUMBER or n.kind == TK_STRING or n.kind == TK_BYTE:
        return true
    if n.kind == TK_KEYWORD and (n.text == 'not' or n.text == 'true' or n.text == 'false' or n.text == 'none'):
        return true
    if n.kind == TK_OP and n.text != '[':
        return true  # `(`, `-`, `&`, `*`: no type starts that way
    if s.chain_decl or n.kind != TK_IDENT:
        return false
    if s.chain_groups >= 2 and not s.chain_empty:
        return true
    int k = i + 2
    if k + 1 < len(toks) and toks[k].kind == TK_OP and toks[k].text == '.' and toks[k + 1].kind == TK_IDENT:
        k += 2
    return not (k < len(toks) and toks[k].kind == TK_OP and toks[k].text == '[')  # a literal's elements

# A single space between s.prev and cur (both on the same line)?
def bool _space_before(Token cur, bool cur_unary, State s):
    Token p = s.prev
    str pt = p.text
    str ct = cur.text
    if _is_opener(p) and p.kind == TK_OP:
        return false
    if _is_closer(cur):
        return false
    if cur.kind == TK_OP and (ct == ',' or ct == ';'):
        return false
    if p.kind == TK_OP and (pt == ',' or pt == ';'):
        return true
    if cur.kind == TK_OP and ct == ':':
        return false
    if p.kind == TK_OP and pt == ':':
        return s.top() == "{"
    if (cur.kind == TK_OP and ct == '.') or (p.kind == TK_OP and pt == '.'):
        return false
    if s.prev_unary:
        return false
    if cur.kind == TK_OP and (ct == '(' or ct == '[' or ct == '{'):
        if s.type_decl and s.count == 2:
            return true  # `type Name [3]int`
        if p.kind == TK_IDENT or p.kind == TK_STRING or (p.kind == TK_OP and (pt == ')' or pt == ']')):
            return false
        return not (p.kind == TK_KEYWORD and _is_type_keyword(pt))
    if p.kind == TK_OP and pt == ']' and s.closed_type_bracket and (_is_word(cur) or cur_unary):
        return false  # [3]int, []*int
    return true

# Whether a type bracket opened now would be in a declaration, where only a type can be: the start
# of a statement or a for loop's initializer, a return type, a parameter, or an alias's target.
def bool _declaration_position(State s):
    if s.count == 0 or s.type_decl:
        return true
    Token p = s.prev
    if p.kind == TK_KEYWORD and (p.text == 'def' or p.text == 'extern' or p.text == 'intrinsic' or p.text == 'for'):
        return true
    return s.decl_header and len(s.brackets) == 1 and p.kind == TK_OP and (p.text == '(' or p.text == ',')

def _advance(*State s, Token cur, bool cur_unary):
    bool continues_chain = s.closed_type_bracket
    s.closed_type_bracket = false
    if cur.kind == TK_OP and (cur.text == '(' or cur.text == '[' or cur.text == '{'):
        bool type_bracket = cur.text == '[' and not s.prev_value
        if type_bracket and continues_chain:
            s.chain_groups += 1
        elif type_bracket:
            s.chain_groups = 1
            s.chain_empty = false
            s.chain_decl = _declaration_position(*s)
        s.brackets = append(s.brackets, cur.text[0])
        s.type_brackets = append(s.type_brackets, type_bracket)
    elif _is_closer(cur) and len(s.brackets) > 0:
        s.closed_type_bracket = cur.text == ']' and s.type_brackets[len(s.type_brackets) - 1]
        if s.closed_type_bracket and s.prev.kind == TK_OP and s.prev.text == '[':
            s.chain_empty = true
        s.brackets = s.brackets[0:len(s.brackets) - 1]
        s.type_brackets = s.type_brackets[0:len(s.type_brackets) - 1]
    s.prev_value = _ends_value(cur, s.closed_type_bracket)
    s.prev_unary = cur_unary
    s.prev = cur
    s.has_prev = true
    s.count += 1
    if s.count == 1:
        s.decl_header = cur.kind == TK_KEYWORD and (cur.text == 'def' or cur.text == 'extern' or cur.text == 'intrinsic')
        s.type_decl = cur.kind == TK_KEYWORD and cur.text == 'type'
    elif s.count == 2 and s.type_decl:
        s.prev_value = false  # `type Name []int`: a type follows the name

def str _spaces(int n):
    Builder b = Builder(none)
    for int i = 0; i < n; i += 1:
        b.write_byte(" ")
    return b.to_str()

# `#text` -> `# text` and `##text` -> `## text` (any run of `#`); other comment text is left alone.
def str _comment(str raw):
    str text = trim(raw)
    int hashes = 0
    while hashes < len(text) and text[hashes] == "#":
        hashes += 1
    if hashes < len(text) and text[hashes] != " " and text[hashes] != "\t":
        return text[0:hashes] + ' ' + text[hashes:len(text)]
    return text

# One formatted output line and what the blank-line rules need to know about it.
type Out struct:
    str text
    bool blank
    bool top_statement  # starts a statement at level 0
    bool top_comment  # comment-only line at level 0
    bool opener  # ends with a block-opening ':'

def []Out _format_lines([]Line lines):
    []Out outs = none
    State s = State(false, Token(0, '', 0, 0, 0), false, false, none, none, false, 0, false, false, 0, false, false)
    int statement_level = 0
    for l in lines:
        if l.blank:
            outs = append(outs, Out('', true, false, false, false))
            continue
        bool starts = _starts_statement(l)
        if starts:
            statement_level = l.level
            s.reset()
        int indent = l.level * INDENT
        if l.continuation:
            indent = (statement_level + l.depth) * INDENT
        Builder b = Builder(none)
        b.write(_spaces(indent))
        bool first = true
        bool opener = false
        for i, t in l.toks:
            if t.kind == TK_COMMENT:
                if not first:
                    b.write('  ')
                b.write(_comment(t.text))
                continue
            bool unary = _is_unary(t, s)
            if unary and t.text == '*' and s.closed_type_bracket and _star_multiplies(l.toks, i, s):
                unary = false
            if not first and _space_before(t, unary, s):
                b.write(' ')
            b.write(t.text)
            _advance(&s, t, unary)
            opener = t.kind == TK_OP and t.text == ':' and len(s.brackets) == 0
            first = false
        bool top_comment = l.comment_only and not l.continuation and l.level == 0
        outs = append(outs, Out(b.to_str(), false, starts and l.level == 0, top_comment, opener))
    return outs

# Collapse blank runs to one; drop blanks at the start, the end, and right after a block opener.
def []Out _collapse_blanks([]Out outs):
    []Out r = none
    for o in outs:
        if o.blank:
            if len(r) == 0 or r[len(r) - 1].blank or r[len(r) - 1].opener:
                continue
        r = append(r, o)
    while len(r) > 0 and r[len(r) - 1].blank:
        r = r[0:len(r) - 1]
    return r

# A top-level statement (with its body) or a block of consecutive top-level comment lines.
type Unit struct:
    int start
    int end  # exclusive, before any trailing blank line
    bool blank_after  # followed by a blank line in the input
    bool comment
    bool multi  # a statement spanning more than one line

# Exactly one blank line around multi-line top-level definitions (and the comments directly
# above them); consecutive one-line declarations keep whatever the input had (0 or 1).
def []Out _space_top_level([]Out r):
    []Unit units = none
    for i, o in r:
        bool comment_start = o.top_comment and (i == 0 or not r[i - 1].top_comment)
        if o.top_statement or comment_start or (i == 0 and not o.blank):
            units = append(units, Unit(i, i, false, o.top_comment, false))
    for k, u in units:
        int next = len(r)
        if k + 1 < len(units):
            next = units[k + 1].start
        int end = next
        if end > u.start and r[end - 1].blank:
            end -= 1
            units[k].blank_after = true
        units[k].end = end
        units[k].multi = not u.comment and end - u.start > 1
    # A comment block directly above a definition takes the definition's side of the rule.
    []bool wide = none
    for u in units:
        wide = append(wide, u.multi)
    int k = len(units) - 2
    while k >= 0:
        if units[k].comment and not units[k].blank_after:
            wide[k] = wide[k + 1]
        k -= 1
    []Out out = none
    for k2, u in units:
        for int i = u.start; i < u.end; i += 1:
            out = append(out, r[i])
        if k2 + 1 < len(units):
            bool attached = u.comment and not u.blank_after
            if not attached and (wide[k2] or wide[k2 + 1] or u.blank_after):
                out = append(out, Out('', true, false, false, false))
    return out

# The last token in toks that isn't a newline or comment, or -1.
def int _last_significant([]Token toks):
    int k = len(toks) - 1
    while k >= 0 and (toks[k].kind == TK_NEWLINE or toks[k].kind == TK_COMMENT):
        k -= 1
    return k

# Index of the `[` matching the `]` at out[k], or -1.
def int _matching_open([]Token out, int k):
    int depth = 0
    int i = k
    while i >= 0:
        if _is_closer(out[i]):
            depth += 1
        elif _is_opener(out[i]):
            depth -= 1
            if depth == 0:
                return i
        i -= 1
    return -1

# Whether the identifier at out[k] ends a typed literal's element type: `[]P`, `[2]*P`, `[]lib.P`,
# `[][]*lib.P`. Going back from the name (possibly qualified, possibly behind `*`s) there must be a
# run of bracket groups that starts where a value would start. `xs[0] * ys` has the same tokens as
# `[]*P` but `[0]` follows a value. `[x][0] * ys` (an indexed literal times an index) can't be told
# from `[N][M]*P` at all, so a pointer element type behind two or more sized groups is not treated
# as a list: hfmt then leaves the commas alone, which is always safe.
def bool _follows_element_type([]Token out, int k):
    int i = _last_significant(out[0:k])
    if i >= 1 and out[i].kind == TK_OP and out[i].text == '.' and out[i - 1].kind == TK_IDENT:
        i = _last_significant(out[0:i - 1])  # qualified name: step over `lib.`
    int stars = 0
    while i >= 0 and out[i].kind == TK_OP and out[i].text == '*':
        stars += 1
        i = _last_significant(out[0:i])
    int groups = 0
    bool empty_group = false
    while i >= 0 and out[i].kind == TK_OP and out[i].text == ']':
        int open = _matching_open(out, i)
        if open < 0 or out[open].text != '[':
            return false
        groups += 1
        empty_group = empty_group or open == i - 1
        i = _last_significant(out[0:open])
    if groups == 0 or (stars > 0 and groups >= 2 and not empty_group):
        return false
    return i < 0 or not _ends_value(out[i], false)

# Whether an opening bracket starts a comma-separated list that may end with a trailing comma: call
# arguments and parameters `f(`, array and slice literals `[` (untyped, or after a typed literal's
# element type), and dict literals `{`. Not grouping parentheses, casts, indexing, or type brackets.
def bool _opens_list([]Token out, Token opener):
    if opener.text == '{':
        return true
    int k = _last_significant(out)
    if k < 0:
        return opener.text == '['
    Token prev = out[k]
    if opener.text == '(':
        return prev.kind == TK_IDENT
    if prev.kind == TK_KEYWORD:
        if prev.text == 'dict' or prev.text == 'true' or prev.text == 'false' or prev.text == 'none':
            return false
        return true  # an element type (`[]int[`) or a keyword like `return`/`in` before a literal
    if prev.kind == TK_IDENT:
        return _follows_element_type(out, k)
    if prev.kind == TK_OP:
        return prev.text != ')' and prev.text != ']' and prev.text != '}'
    return false

# Trailing commas: dropped when the closing bracket follows on the same line (`[1, 2,]` -> `[1, 2]`),
# added to a list whose closing bracket is on its own line.
def []Token _trailing_commas([]Token toks):
    []Token out = none
    []bool lists = none  # per open bracket: whether it is a list
    for t in toks:
        if _is_opener(t):
            lists = append(lists, _opens_list(out, t))
        elif _is_closer(t) and len(lists) > 0:
            bool is_list = lists[len(lists) - 1]
            lists = lists[0:len(lists) - 1]
            int n = len(out)
            if n > 0 and out[n - 1].kind == TK_OP and out[n - 1].text == ',':
                out = out[0:n - 1]
            elif n > 0 and out[n - 1].kind == TK_NEWLINE and is_list:
                int last = _last_significant(out)
                Token e = out[last]
                if not (e.kind == TK_OP and (e.text == ',' or _is_opener(e))):
                    []Token spliced = none
                    for i, x in out:
                        spliced = append(spliced, x)
                        if i == last:
                            spliced = append(spliced, Token(TK_OP, ',', e.line, e.col + len(e.text), e.depth))
                    out = spliced
        out = append(out, t)
    return out

def LayoutResult layout([]Token toks):
    []Line lines = _split_lines(_trailing_commas(toks))
    int bad = _assign_levels(lines)
    if bad >= 0:
        return LayoutError('unindent does not match any outer indentation level', lines[bad].toks[0].line, 1)
    []Out outs = _space_top_level(_collapse_blanks(_format_lines(lines)))
    Builder b = Builder(none)
    for o in outs:
        b.write(o.text)
        b.write('\n')
    return b.to_str()
