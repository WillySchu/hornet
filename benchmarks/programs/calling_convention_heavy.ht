struct Container:
    [3]int values

struct Point:
    int x
    int y

def int sumArray([3]int arr):
    return arr[0] + arr[1] + arr[2]

def int sumSlice([]int s):
    return s[0] + s[1]

def [3]int makeArray(int seed):
    return [seed % 7, (seed + 1) % 7, (seed + 2) % 7]

def [3]int forwardArray(int seed):
    return makeArray(seed)

def [3]int returnLocal(int seed):
    [3]int local = [seed % 5, (seed + 1) % 5, (seed + 2) % 5]
    return local

def Point makePoint(int seed):
    return Point(seed % 11, (seed + 1) % 11)

def int main():
    Container container
    int total = 0
    int i = 0
    while i < 2000000:
        [3]int arr = [i % 10, (i + 1) % 10, (i + 2) % 10]
        []int s = arr[0:2]
        container.values = arr
        int sumArr = sumArray(arr)
        int sumSl = sumSlice(s)
        int sumField = sumArray(container.values)
        [3]int made = makeArray(i)
        int sumMade = made[0] + made[1] + made[2]
        [3]int forwarded = forwardArray(i)
        int sumForwarded = forwarded[0] + forwarded[1] + forwarded[2]
        [3]int returned = returnLocal(i)
        int sumReturned = returned[0] + returned[1] + returned[2]
        Point pt = makePoint(i)
        int sumPoint = pt.x + pt.y
        total = (total + sumArr + sumSl + sumField + sumMade + sumForwarded + sumReturned + sumPoint) % 1000003
        i = i + 1
    return total % 256
