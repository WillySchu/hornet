# Symbol-table-style dict work: int and str keys, insert/delete/lookup/iterate.
from 'fmt' import int_to_str

def int main():
    int checksum = 0
    for int round = 0; round < 25; round += 1:
        dict[int]int d = dict[int]int{}
        for int i = 0; i < 20000; i += 1:
            d[(i * 7919 + round) % 100003] = i
        for int i = 0; i < 20000; i += 2:
            del(d, (i * 7919 + round) % 100003)
        int hits = 0
        for int i = 0; i < 40000; i += 1:
            int key = (i * 7919 + round) % 100003
            if key in d:
                hits += 1
        int s = 0
        for k, v in d:
            s = (s + k * 3 + v) & 1048575
        checksum = (checksum + hits + s + len(d)) & 1048575
    []str keys
    for int i = 0; i < 2000; i += 1:
        keys = append(keys, 'k' + int_to_str(i * 37))
    dict[str]int sd = dict[str]int{}
    for int r = 0; r < 250; r += 1:
        for int i = 0; i < 2000; i += 1:
            str key = keys[(i * 13 + r) % 2000]
            if key in sd:
                sd[key] = (sd[key] + i) & 1048575
            else:
                sd[key] = i
    for k, v in sd:
        checksum = (checksum + v + len(k)) & 1048575
    return (checksum ^ (checksum >> 8) ^ (checksum >> 16)) % 256
