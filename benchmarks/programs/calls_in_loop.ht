# Several locals live across calls to a small leaf function.
def int mix(int x, int y):
    return (x * 31 + y) & 1048575

def int main():
    int s1 = 1
    int s2 = 2
    int s3 = 3
    int s4 = 4
    int s5 = 5
    int i = 0
    while i < 16000000:
        s1 = (s1 + mix(i, s1)) & 1048575
        s2 = (s2 + mix(s1, i)) & 1048575
        s3 = s3 ^ mix(s2, s1)
        s4 = (s4 + s3 + mix(s3, s2)) & 1048575
        s5 = (s5 + mix(s4, s3) + i) & 1048575
        i = i + 1
    return (s1 + s2 + s3 + s4 + s5) % 256
