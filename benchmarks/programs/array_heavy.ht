def int main():
    [3000]int arr
    int i = 0
    while i < 3000:
        arr[i] = 3000 - i
        i = i + 1
    int n = 3000
    int swapped = 1
    int literalSum = 0
    while swapped == 1:
        swapped = 0
        int j = 0
        while j < n - 1:
            if arr[j] > arr[j + 1]:
                int temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
                swapped = 1
            literalSum = (literalSum + [10, 20, 30][j % 3]) % 1000003
            int eqCheck = 0
            if [j % 3, (j % 3) + 1] == [j % 3, (j % 3) + 1]:
                eqCheck = 1
            literalSum = (literalSum + eqCheck) % 1000003
            j = j + 1
        n = n - 1
    return (arr[0] + arr[2999] + literalSum) % 256
