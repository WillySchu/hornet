# Lexer-style byte scan: classify characters and count tokens.
def bool is_alpha(byte b):
    return (b >= "a" and b <= "z") or (b >= "A" and b <= "Z") or b == "_"

def bool is_digit(byte b):
    return b >= "0" and b <= "9"

def int scan(str src):
    int idents = 0
    int numbers = 0
    int ops = 0
    int checksum = 0
    int i = 0
    int n = len(src)
    while i < n:
        byte b = src[i]
        if b == " " or b == "\n" or b == "\t":
            i += 1
        elif b == "#":
            while i < n and src[i] != "\n":
                i += 1
        elif is_alpha(b):
            int start = i
            while i < n and (is_alpha(src[i]) or is_digit(src[i])):
                i += 1
            idents += 1
            checksum = (checksum * 31 + (i - start)) & 1048575
        elif is_digit(b):
            int value = 0
            while i < n and is_digit(src[i]):
                value = value * 10 + int(src[i] - "0")
                i += 1
            numbers += 1
            checksum = (checksum + value) & 1048575
        else:
            ops += 1
            checksum = (checksum ^ int(b)) & 1048575
            i += 1
    return idents * 3 + numbers * 5 + ops * 7 + checksum

def int main():
    str src = 'def f(x_1): return x_1 + 12 * (y - 345) # note\n    z = foo(bar, 7)\n'
    for int k = 0; k < 12; k += 1:
        src = src + src
    int total = 0
    for int r = 0; r < 60; r += 1:
        total = (total + scan(src)) & 1048575
    return (total ^ (total >> 8) ^ (total >> 16)) % 256
