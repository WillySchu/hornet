def int main():
    int total = 0
    int i = 0
    while i < 20000000:
        int k = i % 1000
        int a = k + 3
        int b = k - 1
        int c = (a + b) * (a - b) + (a * b) - (k % 7)
        int negated = -k
        int complemented = ~k
        int8 narrowed = int8(k)
        int widened = int(narrowed)
        total = (total + c + negated + complemented + widened) % 1000003
        i = i + 1
    return total % 256
