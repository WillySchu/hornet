struct Point:
    int x
    int y

def int main():
    [4]int base = [1, 2, 3, 4]
    Point origin = Point(0, 0)
    []int baseSlice = base[0:3]
    [2]Point points
    int total = 0
    int i = 0
    while i < 2000000:
        [4]int copy = base
        copy[0] = i % 100
        Point p = origin
        p.x = i % 50
        []int s = baseSlice
        s[0] = i % 10
        points[0] = p
        Point extracted = points[0]
        []int sliced = base[i % 3:4]
        total = (total + copy[0] + p.x + s[0] + extracted.y + sliced[0]) % 1000003
        i = i + 1
    return total % 256
