struct Point:
    int x
    int y

struct Container:
    []int values

def int main():
    [4]int base = [1, 2, 3, 4]
    Point origin = Point(0, 0)
    []int baseSlice = base[0:3]
    [2]Point points
    Container c
    c.values = base[0:3]
    [1][]int rows
    rows[0] = base[0:3]
    []int growing = none
    []int noInit
    int total = 0
    int i = 0
    while i < 2000000:
        [4]int copy = base
        copy[0] = i % 100
        Point p = origin
        p.x = i % 50
        []int s = baseSlice
        s[0] = i % 10
        points[0] = p
        Point extracted = points[0]
        []int sliced = base[i % 3:4]
        int fromField = c.values[i % 3]
        int fromIndex = rows[0][i % 3]
        int chained = base[i % 2:4][0]
        if i % 50 == 0:
            growing = none
        growing = append(growing, i % 7)
        int appended = growing[len(growing) - 1]
        int isNil = 0
        if noInit == none:
            isNil = 1
        []int literalSlice = [i % 8, (i + 1) % 8]
        int sumLiteralSlice = literalSlice[0] + literalSlice[1]
        total = (total + copy[0] + p.x + s[0] + extracted.y + sliced[0] + fromField + fromIndex + chained + appended + isNil + sumLiteralSlice) % 1000003
        i = i + 1
    return total % 256
