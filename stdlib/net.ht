# TCP connections, made and listened for, through the runtime: C's sockets differ between systems.
from 'c' import from_cstring, to_cstring, from_raw_parts, hornet_alloc_atomic, memcpy
from 'errors' import Error, IntResult, StrResult
from 'fmt' import int_to_str
from 'strings' import index_of_byte

extern int hornet_tcp_connect(*byte host, int port, int timeout_ms)
extern int hornet_tcp_read(int socket, *byte buf, int count)
extern int hornet_tcp_write(int socket, *byte buf, int n)
extern int hornet_tcp_close(int socket)
extern *byte hornet_net_error()
extern int hornet_tcp_listen(*byte host, int port)
extern int hornet_tcp_accept(int listener, int timeout_ms)
extern int hornet_tcp_local_port(int socket)
extern int hornet_tcp_finish(int socket)
intrinsic *byte _raw_ptr(str s)
intrinsic int _raw_len(str s)

const int _CHUNK = 65536

def str _reason():
    return from_cstring(hornet_net_error())

# An open connection: Conn c = ...; c.write('ping'); c.read(); c.close().
type Conn struct:
    int _socket
    *byte _chunk  # where a read arrives, before it is copied out

    # Send all of `data`; how many bytes that was.
    def IntResult write(c, str data):
        if hornet_tcp_write(c._socket, _raw_ptr(data), _raw_len(data)) < 0:
            return Error('write failed: ' + _reason())
        return len(data)

    # What has arrived, up to 64 KB, waiting if nothing has yet; '' once the other side has closed.
    def StrResult read(c):
        int n = hornet_tcp_read(c._socket, c._chunk, _CHUNK)
        if n < 0:
            return Error('read failed: ' + _reason())
        if n == 0:
            return ''
        *byte copy = hornet_alloc_atomic(n)
        memcpy(copy, c._chunk, n)
        return from_raw_parts(copy, n)

    def close(c):
        _ = hornet_tcp_close(c._socket)

    # Close once what was written has gone, reading what the other side still sends (up to a second's
    # worth): closing with that unread would reset the connection, which can lose what was written.
    def finish(c):
        _ = hornet_tcp_finish(c._socket)

type ConnResult is Conn | Error

# Connect to `host` (a name or an address) on `port`. A positive `timeout_ms` bounds each read and
# write (and, on Linux, the connecting itself); 0 waits as long as the system does.
def ConnResult connect(str host, int port, int timeout_ms):
    if len(host) == 0 or index_of_byte(host, "\0") >= 0:
        return Error('could not connect: \'' + host + '\' is not a host name')
    if port < 1 or port > 65535:
        return Error('could not connect: a port is 1 to 65535')
    int socket = hornet_tcp_connect(to_cstring(host), port, timeout_ms)
    if socket < 0:
        return Error('could not connect to ' + host + ': ' + _reason())
    return Conn(socket, hornet_alloc_atomic(_CHUNK))

# A socket listening for connections: Listener l = ...; ConnResult c = l.accept(5000); l.close().
type Listener struct:
    int _socket
    *byte _chunk  # where its connections' reads arrive (each is copied out at once)

    # The next connection made to it, waiting for one. A positive `timeout_ms` bounds each read and
    # write on the connection; 0 waits as long as the system does.
    def ConnResult accept(l, int timeout_ms):
        int socket = hornet_tcp_accept(l._socket, timeout_ms)
        if socket < 0:
            return Error('could not accept a connection: ' + _reason())
        return Conn(socket, l._chunk)

    # The port it listens on: the one the system chose, if it was asked for port 0.
    def int port(l):
        return hornet_tcp_local_port(l._socket)

    def close(l):
        _ = hornet_tcp_close(l._socket)

type ListenerResult is Listener | Error

# Listen on `port` of `host` (an address or a name; '' for all of this machine's). Port 0 asks the
# system for a free one.
def ListenerResult listen(str host, int port):
    str where = host + ':' + int_to_str(port)
    if index_of_byte(host, "\0") >= 0:
        return Error('could not listen: \'' + host + '\' is not a host name')
    if port < 0 or port > 65535:
        return Error('could not listen on ' + where + ': a port is 0 to 65535')
    int socket = hornet_tcp_listen(to_cstring(host), port)
    if socket < 0:
        return Error('could not listen on ' + where + ': ' + _reason())
    return Listener(socket, hornet_alloc_atomic(_CHUNK))
