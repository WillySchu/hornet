from 'c' import from_cstring, to_cstring, from_raw_parts, hornet_alloc
from 'strings' import Builder
from 'errors' import Error, StrResult, IntResult, NoneResult

# argv -> []str. hornet_argv_get does the C-side indexing.
extern *byte hornet_argv_get(*byte argv, int index)

def []str get_args(int argc, *byte argv):
    []str args
    for int i = 0; i < argc; i += 1:
        args = append(args, from_cstring(hornet_argv_get(argv, i)))
    return args

# File I/O, through the runtime: C's own functions differ between systems.
extern int hornet_open_read(*byte path)
extern int hornet_read_fd(int fd, *byte buf, int count)
extern *byte hornet_read_line(*int length)
extern int hornet_is_terminal(int fd)
extern int hornet_close_fd(int fd)
extern int hornet_write_fd(int fd, *byte buf, int n)
extern int hornet_open_write(*byte path)
extern never hornet_exit(int code)
extern *byte hornet_error_message()
extern *byte hornet_get_env(*byte name)
extern int hornet_process_id()
extern *byte hornet_make_temp_dir()
extern int hornet_make_dirs(*byte path)
extern int hornet_path_exists(*byte path)
extern int hornet_rename(*byte old_path, *byte new_path)
extern int hornet_remove(*byte path)
extern *byte hornet_system_error()
intrinsic *byte _raw_ptr(str s)
intrinsic int _raw_len(str s)

def str _os_reason():
    return from_cstring(hornet_error_message())

# Read fd to EOF.
def StrResult read_all_from_fd(int fd):
    Builder b
    *byte chunk = hornet_alloc(65536)
    int n = hornet_read_fd(fd, chunk, 65536)
    while n != 0:
        if n < 0:
            return Error('read failed: ' + _os_reason())
        b.write(from_raw_parts(chunk, n))
        n = hornet_read_fd(fd, chunk, 65536)
    return b.to_str()

def StrResult read_file(str path):
    int fd = hornet_open_read(to_cstring(path))
    if fd < 0:
        return Error('could not open \'' + path + '\': ' + _os_reason())
    defer hornet_close_fd(fd)
    StrResult contents = read_all_from_fd(fd)
    if contents is Error:
        return Error('could not read \'' + path + '\': ' + contents.message)
    return contents

def StrResult read_stdin():
    return read_all_from_fd(0)

# A line of standard input, an Error, or none at the end of the input.
type LineResult is StrResult | none

# The next line of standard input, without its line ending ("\n" or "\r\n").
def LineResult read_line():
    int length = 0
    *byte bytes = hornet_read_line(&length)
    if bytes == none:
        if length < 0:
            return Error('read failed: ' + _os_reason())
        return none
    return from_raw_parts(bytes, length)

# Whether a file descriptor is a terminal: 0 is standard input, 1 standard output.
def bool is_terminal(int fd):
    return hornet_is_terminal(fd) != 0

def IntResult _write_fd(int fd, str s):
    int n = hornet_write_fd(fd, _raw_ptr(s), _raw_len(s))
    if n < 0:
        return Error('write failed: ' + _os_reason())
    return n

# Write s to stdout without a trailing newline (print adds one). Bytes written, or an Error.
def IntResult write_stdout(str s):
    return _write_fd(1, s)

def IntResult write_stderr(str s):
    return _write_fd(2, s)

# Create or truncate `path` and write `content`. Bytes written, or an Error.
def IntResult write_file(str path, str content):
    int fd = hornet_open_write(to_cstring(path))
    if fd < 0:
        return Error('could not open \'' + path + '\' for writing: ' + _os_reason())
    defer hornet_close_fd(fd)
    IntResult written = _write_fd(fd, content)
    if written is Error:
        return Error('could not write \'' + path + '\': ' + written.message)
    return written

# Flush pending output and exit with `code`.
def never exit(int code):
    hornet_exit(code)

# The value of environment variable `name`, or none if it isn't set.
type EnvValue is str | none

def EnvValue get_env(str name):
    *byte value = hornet_get_env(to_cstring(name))
    if value == none:
        return none
    return from_cstring(value)

# This process's id.
def int process_id():
    return hornet_process_id()

def str _system_reason():
    return from_cstring(hornet_system_error())

# A new, empty directory in the system's temporary directory: its path.
def StrResult make_temp_dir():
    *byte path = hornet_make_temp_dir()
    if path == none:
        return Error('could not make a temporary directory: ' + _system_reason())
    return from_cstring(path)

# Make directory `path`, and the directories it is in, where they don't exist yet.
def NoneResult make_dirs(str path):
    if hornet_make_dirs(to_cstring(path)) != 0:
        return Error('could not make directory \'' + path + '\': ' + _system_reason())
    return none

# Whether there is a file or directory at `path`.
def bool exists(str path):
    return hornet_path_exists(to_cstring(path)) != 0

# Rename (move) `old_path` to `new_path`, replacing a file already there.
def NoneResult rename(str old_path, str new_path):
    if hornet_rename(to_cstring(old_path), to_cstring(new_path)) != 0:
        return Error('could not rename \'' + old_path + '\' to \'' + new_path + '\': ' + _system_reason())
    return none

# Remove the file, or the empty directory, at `path`.
def NoneResult remove(str path):
    if hornet_remove(to_cstring(path)) != 0:
        return Error('could not remove \'' + path + '\': ' + _system_reason())
    return none
