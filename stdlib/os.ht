from 'c' import from_cstring, to_cstring, panic, from_raw_parts

# argv -> []str. hornet_argv_get does the C-side indexing.
extern *byte hornet_argv_get(*byte argv, int index)

def []str get_args(int argc, *byte argv):
    []str args = none
    for int i = 0; i < argc; i += 1:
        args = append(args, from_cstring(hornet_argv_get(argv, i)))
    return args

# File I/O.
extern int32 open(*byte path, int32 flags)
extern int read(int32 fd, *byte buf, int count)
extern int32 close(int32 fd)
extern int hornet_write_fd(int fd, *byte buf, int n)
extern int hornet_open_write(*byte path)
extern hornet_exit(int code)
intrinsic *byte _raw_ptr(str s)
intrinsic int _raw_len(str s)

def str read_all_from_fd(int32 fd):
    # Read fd to EOF; panics on read error. Quadratic concatenation.
    str result = ''
    *byte chunk = calloc(65536, 1)
    int n = read(fd, chunk, 65536)
    while n != 0:
        if n < 0:
            panic('read error')
        result = result + from_raw_parts(chunk, n)
        n = read(fd, chunk, 65536)
    return result

def str read_file(str path):
    int32 fd = open(to_cstring(path), 0)
    if fd < int32(0):
        panic('could not open file: ' + path)
    str contents = read_all_from_fd(fd)
    close(fd)
    return contents

def str read_stdin():
    return read_all_from_fd(0)


def _write_fd(int fd, str s):
    if hornet_write_fd(fd, _raw_ptr(s), _raw_len(s)) < 0:
        panic('write error')

# Write s to stdout without a trailing newline (print adds one).
def write_stdout(str s):
    _write_fd(1, s)

def write_stderr(str s):
    _write_fd(2, s)

# Create or truncate `path` and write `content`; panics on error.
def write_file(str path, str content):
    int fd = hornet_open_write(to_cstring(path))
    if fd < 0:
        panic('could not open file for writing: ' + path)
    _write_fd(fd, content)
    close(int32(fd))

# Flush pending output and exit with `code`.
def exit(int code):
    hornet_exit(code)
