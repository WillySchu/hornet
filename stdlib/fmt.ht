# Integer formatting and parsing.
from 'errors' import Error, IntResult

const int _INT_MIN = -9223372036854775807 - 1

def []byte _reverse([]byte b):
    int i = 0
    int j = len(b) - 1
    while i < j:
        byte t = b[i]
        b[i] = b[j]
        b[j] = t
        i += 1
        j -= 1
    return b

# Digits of n in `base` (2..16), with '-' for negatives. Works for every int, including the minimum:
# digits are taken from the negative side, where no value overflows.
def str _format(int n, int base):
    if n == 0:
        return '0'
    str digits = '0123456789abcdef'
    []byte out
    int m = n
    while m != 0:
        int d = m % base
        if d < 0:
            d = -d
        out = append(out, digits[d])
        m = m / base
    if n < 0:
        out = append(out, "-")
    return str(_reverse(out))

def str int_to_str(int n):
    return _format(n, 10)

# Lowercase hex without a prefix; negatives get '-'.
def str int_to_hex(int n):
    return _format(n, 16)

# s padded on the left with `fill` to at least `width` bytes.
def str pad_left(str s, int width, byte fill):
    int missing = width - len(s)
    if missing <= 0:
        return s
    []byte out
    for int i = 0; i < missing; i += 1:
        out = append(out, fill)
    return str(out) + s

# The integer a decimal string spells, with an optional leading '-'; an Error if it isn't one, or
# doesn't fit in an int.
def IntResult parse_int(str s):
    int i = 0
    if len(s) > 0 and s[0] == "-":
        i = 1
    if i == len(s):
        return Error('not a number: \'' + s + '\'')
    # Built as a negative number, whose range reaches one further than a positive one's.
    int value = 0
    while i < len(s):
        if s[i] < "0" or s[i] > "9":
            return Error('not a number: \'' + s + '\'')
        int digit = int(s[i]) - 48
        if value < (_INT_MIN + digit) / 10:
            return Error('number too large: \'' + s + '\'')
        value = value * 10 - digit
        i += 1
    if s[0] == "-":
        return value
    if value == _INT_MIN:
        return Error('number too large: \'' + s + '\'')
    return -value
