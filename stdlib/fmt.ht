from 'c' import panic

# Single digit 0-9 as a str.
def str _digit_to_str(int d):
    if d == 0:
        return '0'
    if d == 1:
        return '1'
    if d == 2:
        return '2'
    if d == 3:
        return '3'
    if d == 4:
        return '4'
    if d == 5:
        return '5'
    if d == 6:
        return '6'
    if d == 7:
        return '7'
    if d == 8:
        return '8'
    return '9'

def str int_to_str(int n):
    # Non-negative only.
    if n < 0:
        panic('int_to_str: negative numbers are not supported yet')
    if n == 0:
        return '0'
    str result = ''
    int remaining = n
    while remaining > 0:
        result = _digit_to_str(remaining % 10) + result
        remaining = remaining / 10
    return result
