# HTTP/1.1 over plain TCP: requests, and a server. There is no TLS yet: an `https://` URL is an Error.
#
#   ResponseResult r = get('http://example.com/')
#   if r is Response:
#       print(r.body)
#
# One request to a connection, redirects are the caller's to follow, and a body is held whole.
# The server (listen) answers a request at a time: see Server.
from 'errors' import Error, IntResult, NoneResult, StrResult
from 'fmt' import int_to_str, parse_int
from 'net' import Conn, ConnResult, Listener, ListenerResult, connect, listen as tcp_listen
from 'strings' import Builder, ends_with, index_of, index_of_byte, lower, split, starts_with, trim
from 'time' import DateTime, now_ms, utc

# What get and post allow each read and write, and a server each read and write of a connection,
# in milliseconds.
const int TIMEOUT_MS = 30000
# A status line and headers longer than this aren't a response.
const int _MAX_HEAD = 1048576
# A request's line and headers longer than this are refused (414, 431), as is a body longer than
# the server's max_body (413), which is this unless set.
const int _MAX_REQUEST_HEAD = 65536
const int _MAX_BODY = 1048576

type Header struct:
    str name
    str value

type Response struct:
    int status  # 200
    str reason  # 'OK'
    []Header headers  # as sent, in order
    str body

    # The value of the first header called `name`, however either is cased; '' if there is none.
    def str header(r, str name):
        str wanted = lower(name)
        for h in r.headers:
            if lower(h.name) == wanted:
                return h.value
        return ''

type ResponseResult is Response | Error

# Where a URL's request goes, and what it asks for there.
type Url struct:
    str host
    int port
    str target  # the path and query, as the request line gives them

type UrlResult is Url | Error

type _More is bool | Error

# Whether `s` can be a method or a header's name: no spaces, control characters, or colons.
def bool _is_token(str s):
    for c in s:
        if c <= " " or c >= "\x7f" or c == ":":
            return false
    return len(s) > 0

def IntResult _parse_hex(str s):
    if len(s) == 0 or len(s) > 15:
        return Error('malformed chunk size \'' + s + '\'')
    int value = 0
    for c in s:
        int digit = -1
        if c >= "0" and c <= "9":
            digit = int(c) - 48
        elif c >= "a" and c <= "f":
            digit = int(c) - 87
        elif c >= "A" and c <= "F":
            digit = int(c) - 55
        if digit < 0:
            return Error('malformed chunk size \'' + s + '\'')
        value = value * 16 + digit
    return value

# `http://host[:port][/path][?query]`; an address in brackets (`[::1]`) is an IPv6 one.
def UrlResult parse_url(str url):
    for c in url:
        if c <= " " or c == "\x7f":
            return Error('a URL can\'t contain spaces or control characters')
    int scheme_end = index_of(url, '://')
    if scheme_end < 0:
        return Error('not a URL (it has no scheme): \'' + url + '\'')
    str scheme = lower(url[0:scheme_end])
    if scheme == 'https':
        return Error('https is not supported: there is no TLS yet')
    if scheme != 'http':
        return Error('unsupported URL scheme \'' + scheme + '\'')
    str rest = url[scheme_end + 3:]
    int fragment = index_of_byte(rest, "#")
    if fragment >= 0:
        rest = rest[0:fragment]
    int authority_end = len(rest)
    for i, c in rest:
        if c == "/" or c == "?":
            authority_end = i
            break
    str authority = rest[0:authority_end]
    str target = rest[authority_end:]
    if len(target) == 0 or target[0] != "/":
        target = '/' + target
    if index_of_byte(authority, "@") >= 0:
        return Error('a URL with a user name is not supported')
    str host = authority
    int colon = -1
    if starts_with(authority, '['):
        int bracket = index_of_byte(authority, "]")
        if bracket < 0 or (bracket + 1 < len(authority) and authority[bracket + 1] != ":"):
            return Error('malformed address in URL: \'' + authority + '\'')
        host = authority[1:bracket]
        if bracket + 1 < len(authority):
            colon = bracket + 1
    else:
        colon = index_of_byte(authority, ":")
        if colon >= 0:
            host = authority[0:colon]
    int port = 80
    if colon >= 0:
        IntResult given = parse_int(authority[colon + 1:])
        if given is Error or given < 1 or given > 65535:
            return Error('malformed port in URL: \'' + authority + '\'')
        port = given
    if len(host) == 0:
        return Error('a URL needs a host: \'' + url + '\'')
    return Url(host, port, target)

# The request as it is sent. Host, Connection, and Content-Length are written here; `headers` adds to them.
def StrResult _request_text(str method, Url url, []Header headers, str body):
    if not _is_token(method):
        return Error('not an HTTP method: \'' + method + '\'')
    str host = url.host
    if index_of_byte(host, ":") >= 0:
        host = '[' + host + ']'
    if url.port != 80:
        host = host + ':' + int_to_str(url.port)
    Builder b
    b.write(method + ' ' + url.target + ' HTTP/1.1\r\nHost: ' + host + '\r\nConnection: close\r\n')
    for h in headers:
        if not _is_token(h.name) or index_of_byte(h.value, "\r") >= 0 or index_of_byte(h.value, "\n") >= 0:
            return Error('malformed header \'' + h.name + '\'')
        b.write(h.name + ': ' + h.value + '\r\n')
    if len(body) > 0 or method in ['POST', 'PUT', 'PATCH']:
        b.write('Content-Length: ' + int_to_str(len(body)) + '\r\n')
    b.write('\r\n')
    b.write(body)
    return b.to_str()

# What has arrived on a connection and not been used yet.
type _Reader struct:
    Conn conn
    []byte buf
    int pos  # where in buf the unused part starts
    bool ended  # the other side has closed
    str what  # 'response' or 'request', for errors
    int line_limit  # the longest line taken: a longer one is an Error, and sets `overlong`
    bool overlong
    bool too_big  # a chunked body was longer than _read_chunked was allowed

    # Wait for more to arrive; false once there is no more to come.
    def _More fill(*r):
        if r.ended:
            return false
        StrResult got = r.conn.read()
        if got is Error:
            return got
        if len(got) == 0:
            r.ended = true
            return false
        if r.pos == len(r.buf):  # all used: start afresh, and let the old go
            r.buf = []
            r.pos = 0
        elif r.pos >= 65536:  # much used: keep only the rest
            []byte rest
            r.buf = append(rest, r.buf[r.pos:]...)
            r.pos = 0
        r.buf = append(r.buf, got...)
        return true

    # The next line, without its "\r\n" (a bare "\n" ends one too).
    def StrResult line(*r):
        int scanned = 0  # of what follows pos, how much has no line end
        while true:
            while r.pos + scanned < len(r.buf):
                int i = r.pos + scanned
                if r.buf[i] == "\n":
                    if scanned > r.line_limit:
                        break
                    int end = i
                    if end > r.pos and r.buf[end - 1] == "\r":
                        end -= 1
                    str text = str(r.buf[r.pos:end])
                    r.pos = i + 1
                    return text
                scanned += 1
            if scanned > r.line_limit:
                r.overlong = true
                return Error('not an HTTP ' + r.what + ': a line of it is over ' + _size_text(r.line_limit))
            _More more = r.fill()
            if more is Error:
                return more
            if not more:
                return Error('the connection closed in the middle of the ' + r.what)

    # The next `n` bytes.
    def StrResult take(*r, int n):
        while len(r.buf) - r.pos < n:
            _More more = r.fill()
            if more is Error:
                return more
            if not more:
                return Error('the connection closed before the whole body arrived')
        str text = str(r.buf[r.pos:r.pos + n])
        r.pos += n
        return text

    # Everything up to the connection's close.
    def StrResult rest(*r):
        while true:
            _More more = r.fill()
            if more is Error:
                return more
            if not more:
                break
        str text = str(r.buf[r.pos:])
        r.pos = len(r.buf)
        return text

def str _size_text(int bytes):
    if bytes % 1048576 == 0:
        return int_to_str(bytes / 1048576) + ' MB'
    if bytes % 1024 == 0:
        return int_to_str(bytes / 1024) + ' KB'
    return int_to_str(bytes) + ' bytes'

# A body sent in chunks: each a line giving its size in hex, then that many bytes; a size of 0 ends it.
# One longer than `max` bytes (if not negative) is an Error, and sets r.too_big.
def StrResult _read_chunked(*_Reader r, int max):
    Builder body
    while true:
        StrResult size_line = r.line()
        if size_line is Error:
            return size_line
        str digits = size_line
        int extension = index_of_byte(size_line, ";")
        if extension >= 0:
            digits = size_line[0:extension]
        IntResult size = _parse_hex(trim(digits))
        if size is Error:
            return size
        if size == 0:
            break
        if max >= 0 and body.length() + size > max:
            r.too_big = true
            return Error('the body is over ' + _size_text(max))
        StrResult data = r.take(size)
        if data is Error:
            return data
        body.write(data)
        StrResult after = r.line()
        if after is Error:
            return after
        if len(after) != 0:
            return Error('malformed chunk: no line end after its data')
    while true:  # trailers, to the empty line that ends them
        StrResult trailer = r.line()
        if trailer is Error:
            return trailer
        if len(trailer) == 0:
            break
    return body.to_str()

# The body that follows `head`: how much there is depends on the request and on head's status and headers.
def StrResult _read_body(*_Reader r, Response head, bool head_request):
    if head_request or head.status == 204 or head.status == 304:
        return ''
    if ends_with(lower(trim(head.header('Transfer-Encoding'))), 'chunked'):
        return _read_chunked(r, -1)
    str length = trim(head.header('Content-Length'))
    if len(length) == 0:
        return r.rest()
    IntResult n = parse_int(length)
    if n is Error or n < 0:
        return Error('malformed Content-Length \'' + length + '\'')
    return r.take(n)

def ResponseResult _read_response(*_Reader r, bool head_request):
    while true:
        StrResult status_line = r.line()
        if status_line is Error:
            return status_line
        int space = index_of_byte(status_line, " ")
        if not starts_with(status_line, 'HTTP/') or space < 0 or len(status_line) < space + 4:
            return Error('not an HTTP response: it starts \'' + status_line + '\'')
        IntResult status = parse_int(status_line[space + 1:space + 4])
        if status is Error or status < 100:
            return Error('not an HTTP response: it starts \'' + status_line + '\'')
        int head_bytes = 0
        []Header headers
        while true:
            StrResult h = r.line()
            if h is Error:
                return h
            if len(h) == 0:
                break
            head_bytes += len(h) + 2
            if head_bytes > _MAX_HEAD:
                return Error('not an HTTP response: its headers are over 1 MB')
            int colon = index_of_byte(h, ":")
            if (h[0] == " " or h[0] == "\t") and len(headers) > 0:  # a header's value, carried on
                headers[len(headers) - 1].value += ' ' + trim(h)
            elif colon > 0:
                headers = append(headers, Header(trim(h[0:colon]), trim(h[colon + 1:])))
            else:
                return Error('malformed header in response: \'' + h + '\'')
        if status >= 100 and status < 200 and status != 101:
            continue  # an interim response: the real one follows
        Response response = Response(status, trim(status_line[space + 4:]), headers, '')
        StrResult body = _read_body(r, response, head_request)
        if body is Error:
            return body
        response.body = body
        return response

# Send one request and read its response. `headers` are sent besides Host, Connection, and
# Content-Length, which are set here. `timeout_ms` bounds each read and write (0: no bound).
def ResponseResult request(str method, str url, []Header headers, str body, int timeout_ms):
    UrlResult parsed = parse_url(url)
    if parsed is Error:
        return parsed
    StrResult text = _request_text(method, parsed, headers, body)
    if text is Error:
        return text
    ConnResult conn = connect(parsed.host, parsed.port, timeout_ms)
    if conn is Error:
        return conn
    defer conn.close()
    IntResult sent = conn.write(text)
    if sent is Error:
        return sent
    _Reader reader = _Reader(conn, [], 0, false, 'response', _MAX_HEAD, false, false)
    return _read_response(&reader, method == 'HEAD')

def ResponseResult get(str url):
    return request('GET', url, [], '', TIMEOUT_MS)

def ResponseResult post(str url, str content_type, str body):
    return request('POST', url, [Header('Content-Type', content_type)], body, TIMEOUT_MS)

# ---- Serving.

# A request a server has read.
type Request struct:
    str method  # 'GET'
    str target  # as sent: '/a%20b?x=1' (an absolute URL's path and query only)
    str path  # the target's path, percent-decoded: '/a b'
    str query  # what follows the target's '?', as sent: 'x=1'
    []Header headers  # as sent, in order
    str body
    Conn _conn

    # The value of the first header called `name`, however either is cased; '' if there is none.
    def str header(r, str name):
        str wanted = lower(name)
        for h in r.headers:
            if lower(h.name) == wanted:
                return h.value
        return ''

type RequestResult is Request | Error

# A request answered by the server itself: a status (400, 413, ...) and why.
type _Refusal struct:
    int status
    str message

type _Received is Request | _Refusal | Error

# Serves HTTP/1.1, a request at a time, each on a connection of its own:
#
#   ServerResult s = listen('127.0.0.1', 8080)
#   ...
#   while true:
#       RequestResult r = s.next()
#       if r is Request:
#           _ = s.respond(r, Response(200, '', [Header('Content-Type', 'text/plain')], 'hello\n'))
#
# A malformed or oversized request is answered (400, 413, 414, 431, 501, 505) and passed over, as is
# one whose client goes quiet for timeout_ms or closes. While a request is read or answered, other
# clients wait.
type Server struct:
    Listener _listener
    int timeout_ms  # bounds each read and write of a connection (0: no bound)
    int max_body  # the longest body a request may have, in bytes

    # The port it listens on: the one the system chose, if it was asked for port 0.
    def int port(s):
        return s._listener.port()

    # The next request, waiting for one. An Error only if no connection could be accepted.
    def RequestResult next(s):
        while true:
            ConnResult conn = s._listener.accept(s.timeout_ms)
            if conn is Error:
                return conn
            _Reader reader = _Reader(conn, [], 0, false, 'request', _MAX_REQUEST_HEAD, false, false)
            _Received got = _read_request(&reader, s.max_body)
            match got as g:
                is Request:
                    return g
                is _Refusal:
                    []Header headers = [Header('Content-Type', 'text/plain')]
                    StrResult text = _response_text(Response(g.status, '', headers, g.message + '\n'), false)
                    if text is str:
                        _ = conn.write(text)
                    conn.finish()
                is Error:  # it closed, went quiet, or failed
                    conn.finish()

    # Answer `request` with `response`, and close its connection. Date, Connection, and Content-Length
    # are written here (any in response.headers are left out); a reason of '' is the status's usual
    # one. A response to HEAD has its Content-Length but no body.
    def NoneResult respond(s, Request request, Response response):
        StrResult text = _response_text(response, request.method == 'HEAD')
        if text is Error:
            request._conn.finish()
            return text
        IntResult sent = request._conn.write(text)
        request._conn.finish()
        if sent is Error:
            return sent
        return none

    def close(s):
        s._listener.close()

type ServerResult is Server | Error

# Serve on `port` of `host` (an address or a name; '' for all of this machine's). Port 0 asks the
# system for a free one (Server.port).
def ServerResult listen(str host, int port):
    ListenerResult listener = tcp_listen(host, port)
    if listener is Error:
        return listener
    return Server(listener, TIMEOUT_MS, _MAX_BODY)

def _Received _read_request(*_Reader r, int max_body):
    StrResult request_line = r.line()
    while true:  # (empty lines before one are allowed)
        if request_line is Error or len(request_line) > 0:
            break
        request_line = r.line()
    if request_line is Error:
        if r.overlong:
            return _Refusal(414, 'URI Too Long')
        return request_line
    []str parts = split(request_line, ' ')
    if len(parts) != 3 or not _is_token(parts[0]) or not starts_with(parts[2], 'HTTP/'):
        return _Refusal(400, 'Bad Request: malformed request line')
    if not starts_with(parts[2], 'HTTP/1.'):
        return _Refusal(505, 'HTTP Version Not Supported')
    str method = parts[0]
    str target = parts[1]
    if starts_with(lower(target), 'http://'):  # the absolute form, as to a proxy
        UrlResult url = parse_url(target)
        if url is Error:
            return _Refusal(400, 'Bad Request: malformed target')
        target = url.target
    elif not starts_with(target, '/') and not (target == '*' and method == 'OPTIONS'):
        return _Refusal(400, 'Bad Request: malformed target')
    str raw_path = target
    str query = ''
    int mark = index_of_byte(target, "?")
    if mark >= 0:
        raw_path = target[0:mark]
        query = target[mark + 1:]
    StrResult path = percent_decode(raw_path)
    if path is Error or index_of_byte(path, "\0") >= 0:
        return _Refusal(400, 'Bad Request: malformed path')
    int head_bytes = 0
    []Header headers
    while true:
        StrResult h = r.line()
        if h is Error:
            if r.overlong:
                return _Refusal(431, 'Request Header Fields Too Large')
            return h
        if len(h) == 0:
            break
        head_bytes += len(h) + 2
        if head_bytes > _MAX_REQUEST_HEAD:
            return _Refusal(431, 'Request Header Fields Too Large')
        int colon = index_of_byte(h, ":")
        if colon <= 0 or not _is_token(h[0:colon]):  # (a value carried onto the next line included)
            return _Refusal(400, 'Bad Request: malformed header')
        headers = append(headers, Header(h[0:colon], trim(h[colon + 1:])))
    Request request = Request(method, target, path, query, headers, '', r.conn)
    str coding = lower(trim(request.header('Transfer-Encoding')))
    []str lengths
    for h in headers:
        if lower(h.name) == 'content-length':
            lengths = append(lengths, h.value)
    str expect = lower(request.header('Expect'))
    if len(expect) > 0 and expect != '100-continue':
        return _Refusal(417, 'Expectation Failed')
    if len(coding) > 0:
        if len(lengths) > 0:  # (which says where the body ends is in doubt)
            return _Refusal(400, 'Bad Request: both Transfer-Encoding and Content-Length')
        if coding != 'chunked':
            return _Refusal(501, 'Not Implemented: Transfer-Encoding ' + coding)
        if len(expect) > 0:
            _ = r.conn.write('HTTP/1.1 100 Continue\r\n\r\n')
        StrResult body = _read_chunked(r, max_body)
        if body is Error:
            if r.too_big:
                return _Refusal(413, 'Content Too Large')
            if r.overlong:
                return _Refusal(400, 'Bad Request: malformed chunk')
            if starts_with(body.message, 'malformed'):
                return _Refusal(400, 'Bad Request: ' + body.message)
            return body
        request.body = body
    elif len(lengths) > 0:
        for other in lengths:
            if other != lengths[0]:
                return _Refusal(400, 'Bad Request: conflicting Content-Length')
        if len(lengths[0]) == 0 or len(lengths[0]) > 15 or not _is_digits(lengths[0]):
            return _Refusal(400, 'Bad Request: malformed Content-Length')
        int n = 0
        IntResult parsed = parse_int(lengths[0])
        if parsed is int:
            n = parsed
        if n > max_body:
            return _Refusal(413, 'Content Too Large')
        if n > 0 and len(expect) > 0:
            _ = r.conn.write('HTTP/1.1 100 Continue\r\n\r\n')
        StrResult body = r.take(n)
        if body is Error:
            return body
        request.body = body
    return request

def bool _is_digits(str s):
    for c in s:
        if c < "0" or c > "9":
            return false
    return true

# The response as it is sent (see Server.respond).
def StrResult _response_text(Response response, bool head_request):
    int status = response.status
    if status < 200 or status > 599:
        return Error('not a final HTTP status: ' + int_to_str(status))
    str reason = response.reason
    if len(reason) == 0:
        reason = status_text(status)
    if index_of_byte(reason, "\r") >= 0 or index_of_byte(reason, "\n") >= 0:
        return Error('malformed reason \'' + reason + '\'')
    Builder b
    b.write('HTTP/1.1 ' + int_to_str(status) + ' ' + reason + '\r\nDate: ' + http_date(now_ms()))
    b.write('\r\nConnection: close\r\n')
    for h in response.headers:
        if not _is_token(h.name) or index_of_byte(h.value, "\r") >= 0 or index_of_byte(h.value, "\n") >= 0:
            return Error('malformed header \'' + h.name + '\'')
        if not (lower(h.name) in ['date', 'connection', 'content-length']):
            b.write(h.name + ': ' + h.value + '\r\n')
    bool bodiless = status == 204 or status == 304
    if not bodiless:
        b.write('Content-Length: ' + int_to_str(len(response.body)) + '\r\n')
    b.write('\r\n')
    if not bodiless and not head_request:
        b.write(response.body)
    return b.to_str()

# A status's usual reason: status_text(404) is 'Not Found'; '' for one this doesn't know.
def str status_text(int status):
    if status == 200:
        return 'OK'
    if status == 201:
        return 'Created'
    if status == 202:
        return 'Accepted'
    if status == 204:
        return 'No Content'
    if status == 206:
        return 'Partial Content'
    if status == 301:
        return 'Moved Permanently'
    if status == 302:
        return 'Found'
    if status == 303:
        return 'See Other'
    if status == 304:
        return 'Not Modified'
    if status == 307:
        return 'Temporary Redirect'
    if status == 308:
        return 'Permanent Redirect'
    if status == 400:
        return 'Bad Request'
    if status == 401:
        return 'Unauthorized'
    if status == 403:
        return 'Forbidden'
    if status == 404:
        return 'Not Found'
    if status == 405:
        return 'Method Not Allowed'
    if status == 408:
        return 'Request Timeout'
    if status == 409:
        return 'Conflict'
    if status == 410:
        return 'Gone'
    if status == 411:
        return 'Length Required'
    if status == 413:
        return 'Content Too Large'
    if status == 414:
        return 'URI Too Long'
    if status == 415:
        return 'Unsupported Media Type'
    if status == 417:
        return 'Expectation Failed'
    if status == 422:
        return 'Unprocessable Content'
    if status == 429:
        return 'Too Many Requests'
    if status == 431:
        return 'Request Header Fields Too Large'
    if status == 500:
        return 'Internal Server Error'
    if status == 501:
        return 'Not Implemented'
    if status == 502:
        return 'Bad Gateway'
    if status == 503:
        return 'Service Unavailable'
    if status == 504:
        return 'Gateway Timeout'
    if status == 505:
        return 'HTTP Version Not Supported'
    return ''

# `ms` (since 1970-01-01 00:00 UTC) as HTTP writes a date: 'Sun, 06 Nov 1994 08:49:37 GMT'.
def str http_date(int ms):
    DateTime t = utc(ms)
    [7]str days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
    [12]str months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    str date = days[t.weekday] + ', ' + _padded(t.day, 2) + ' ' + months[t.month - 1] + ' ' + _padded(t.year, 4)
    return date + ' ' + _padded(t.hour, 2) + ':' + _padded(t.minute, 2) + ':' + _padded(t.second, 2) + ' GMT'

def str _padded(int n, int width):
    str digits = int_to_str(n)
    while len(digits) < width:
        digits = '0' + digits
    return digits

# `s` with each %XX as the byte it stands for: '/a%20b' is '/a b'. A % not followed by two hex
# digits is an Error.
def StrResult percent_decode(str s):
    if index_of_byte(s, "%") < 0:
        return s
    []byte out
    int i = 0
    while i < len(s):
        if s[i] != "%":
            out = append(out, s[i])
            i += 1
            continue
        int high = -1
        int low = -1
        if i + 2 < len(s):
            high = _hex_digit(s[i + 1])
            low = _hex_digit(s[i + 2])
        if high < 0 or low < 0:
            return Error('malformed percent escape in \'' + s + '\'')
        out = append(out, byte(high * 16 + low))
        i += 3
    return str(out)

def int _hex_digit(byte c):
    if c >= "0" and c <= "9":
        return int(c) - 48
    if c >= "a" and c <= "f":
        return int(c) - 87
    if c >= "A" and c <= "F":
        return int(c) - 55
    return -1

# A query's names and values ('a=1&b=two+words'), each decoded ('+' is a space). A name given twice
# keeps its first value; a part that can't be decoded is kept as sent.
def dict[str]str parse_query(str query):
    dict[str]str values
    if len(query) == 0:
        return values
    for part in split(query, '&'):
        if len(part) == 0:
            continue
        str name = part
        str value = ''
        int equals = index_of_byte(part, "=")
        if equals >= 0:
            name = part[0:equals]
            value = part[equals + 1:]
        name = _form_decode(name)
        if not (name in values):
            values[name] = _form_decode(value)
    return values

def str _form_decode(str s):
    []byte spaced = bytes(s)
    for i, c in spaced:
        if c == "+":
            spaced[i] = " "
    StrResult decoded = percent_decode(str(spaced))
    if decoded is Error:
        return str(spaced)
    return decoded
