def str main():
    []int sl = sliceints()
    print(sl)
    int i = sliceints()[0]
    print(i)
    [5]int arr = ints()
    print_arr(arr)
    print_arr(ints())
    return ''


def str hello():
    str hello = 'hello'
    return hello


def str world(str p):
    return 'world' + p


def []int sliceints():
    [5]int arr = [1, 2, 3, 4, 5]
    return arr[:]


def [5]int ints():
    [5]int arr = [1, 2, 3, 4, 5]
    return arr


def print_arr([5]int arr):
    print(arr)
