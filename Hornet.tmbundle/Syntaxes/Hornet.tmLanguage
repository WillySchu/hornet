<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Hornet</string>
	<key>scopeName</key>
	<string>source.hornet</string>
	<key>fileTypes</key>
	<array>
		<string>ht</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#bytes</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#function-definitions</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#foreign-declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#type-declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#imports</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#builtins</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#types</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#booleans</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#none</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#function-calls</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#member-access</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>comment.line.number-sign.hornet</string>
					<key>match</key>
					<string>#[^\n]*$</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>string.quoted.single.hornet</string>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'|$</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.string.begin.hornet</string>
						</dict>
					</dict>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.string.end.hornet</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.hornet</string>
							<key>match</key>
							<string>\\x[0-9A-Fa-f]{2}|\\.</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>bytes</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>string.quoted.double.hornet</string>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"|$</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.string.begin.hornet</string>
						</dict>
					</dict>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.string.end.hornet</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.hornet</string>
							<key>match</key>
							<string>\\x[0-9A-Fa-f]{2}|\\.</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>function-definitions</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>\b(def)\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.function.hornet</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\)</string>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.parameters.end.hornet</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>[A-Za-z_]\w*(?=\s*\()</string>
							<key>name</key>
							<string>entity.name.function.hornet</string>
						</dict>
						<dict>
							<key>match</key>
							<string>(?&lt;=\()\s*(\*)?([A-Za-z_]\w*)(?=\s*[,)])</string>
							<key>captures</key>
							<dict>
								<key>1</key>
								<dict>
									<key>name</key>
									<string>storage.type.pointer.hornet</string>
								</dict>
								<key>2</key>
								<dict>
									<key>name</key>
									<string>variable.parameter.receiver.hornet</string>
								</dict>
							</dict>
						</dict>
						<dict>
							<key>include</key>
							<string>#types</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#punctuation</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>foreign-declarations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>\b(extern|intrinsic)\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.foreign.hornet</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\)</string>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.parameters.end.hornet</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>[A-Za-z_]\w*(?=\s*\()</string>
							<key>name</key>
							<string>entity.name.function.foreign.hornet</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#types</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#punctuation</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>type-declarations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>comment</key>
					<string>A sum type: `type NAME is A | B | none`, to the end of the line.</string>
					<key>begin</key>
					<string>\b(type)\s+([A-Za-z_]\w*)\s+(is)\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.type.hornet</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.hornet</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.type.hornet</string>
						</dict>
					</dict>
					<key>end</key>
					<string>$</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#comments</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#none</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#types</string>
						</dict>
						<dict>
							<key>name</key>
							<string>entity.name.type.variant.hornet</string>
							<key>match</key>
							<string>(?:[A-Za-z_]\w*\.)?[A-Za-z_]\w*</string>
						</dict>
						<dict>
							<key>name</key>
							<string>punctuation.separator.variant.hornet</string>
							<key>match</key>
							<string>\|</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#punctuation</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(type)\s+([A-Za-z_]\w*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.type.hornet</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.hornet</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:struct|enum)\b</string>
					<key>name</key>
					<string>keyword.declaration.type.hornet</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>The variant an `is` check tests; `none` and builtin types keep their own scopes.</string>
					<key>name</key>
					<string>entity.name.type.variant.hornet</string>
					<key>match</key>
					<string>(?&lt;=\bis\s)(?!(?:none|int|int8|uint8|int32|int64|bool|str|byte|dict)\b)(?:[A-Za-z_]\w*\.)?[A-Za-z_]\w*</string>
				</dict>
			</array>
		</dict>
		<key>imports</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(import|from)\b\s*('[^'\n]*'|\"[^\"\n]*\")</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.import.hornet</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>string.unquoted.module.hornet</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.control.import.hornet</string>
					<key>match</key>
					<string>\bas\b</string>
				</dict>
			</array>
		</dict>
		<key>builtins</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>support.function.builtin.hornet</string>
					<key>match</key>
					<string>\b(?:print|len|append|del|bytes|panic)\b</string>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.hornet</string>
					<key>match</key>
					<string>\b(?:return|if|elif|else|for|in|while|break|continue|match)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.logical.hornet</string>
					<key>match</key>
					<string>\b(?:and|or|not)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.control.pattern.hornet</string>
					<key>match</key>
					<string>\bis\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.modifier.const.hornet</string>
					<key>match</key>
					<string>\bconst\b</string>
				</dict>
			</array>
		</dict>
		<key>types</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>storage.type.primitive.hornet</string>
					<key>match</key>
					<string>\b(?:int|int8|uint8|int32|int64|bool|str|byte|never)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.type.collection.hornet</string>
					<key>match</key>
					<string>\bdict\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.type.pointer.hornet</string>
					<key>match</key>
					<string>\*(?=\s*[A-Za-z_\[])</string>
				</dict>
			</array>
		</dict>
		<key>booleans</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.language.boolean.hornet</string>
					<key>match</key>
					<string>\b(?:true|false)\b</string>
				</dict>
			</array>
		</dict>
		<key>none</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.language.none.hornet</string>
					<key>match</key>
					<string>\bnone\b</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.hornet</string>
					<key>match</key>
					<string>(?&lt;![A-Za-z_])(?:\d+\.\d+|\d+)(?![A-Za-z_])</string>
				</dict>
			</array>
		</dict>
		<key>function-calls</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>entity.name.function.call.hornet</string>
					<key>match</key>
					<string>\b[A-Za-z_]\w*(?=\s*\()</string>
				</dict>
			</array>
		</dict>
		<key>member-access</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>variable.other.member.hornet</string>
					<key>match</key>
					<string>(?&lt;=\.)[A-Za-z_]\w*</string>
				</dict>
			</array>
		</dict>
		<key>operators</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.hornet</string>
					<key>match</key>
					<string>(?:&lt;&lt;=|&gt;&gt;=|\+=|-=|\*=|/=|%=|&amp;=|\|=|\^=|=)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.comparison.hornet</string>
					<key>match</key>
					<string>(?:==|!=|&lt;=|&gt;=)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.arithmetic.hornet</string>
					<key>match</key>
					<string>&lt;&lt;|&gt;&gt;|[+\-*/%~&amp;|^&lt;&gt;]</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>punctuation.definition.parameters.begin.hornet</string>
					<key>match</key>
					<string>\(</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.parameters.end.hornet</string>
					<key>match</key>
					<string>\)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.array.begin.hornet</string>
					<key>match</key>
					<string>\[</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.array.end.hornet</string>
					<key>match</key>
					<string>\]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.dictionary.begin.hornet</string>
					<key>match</key>
					<string>\{</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.dictionary.end.hornet</string>
					<key>match</key>
					<string>\}</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.separator.hornet</string>
					<key>match</key>
					<string>[:,.]</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
