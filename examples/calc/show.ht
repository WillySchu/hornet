# Trees and instructions as text.
from 'fmt' import int_to_str
from 'strings' import Builder
from 'parser' import Expr, Num, Name, Unary, Binary, Op
from 'code' import Instruction, Opcode

def str symbol(Op op):
    match op:
        is Add:
            return '+'
        is Sub:
            return '-'
        is Mul:
            return '*'
        is Div:
            return '/'
        is Mod:
            return '%'
        is Equal:
            return '=='
        is NotEqual:
            return '!='
        is Less:
            return '<'
        is LessEqual:
            return '<='
        is Greater:
            return '>'
        is GreaterEqual:
            return '>='
        is And:
            return 'and'
        is Or:
            return 'or'
        is Negate:
            return '-'
        is Not:
            return 'not'

# A tree with every operation in parentheses, its operator first: `1 + 2 * x` is `(+ 1 (* 2 x))`.
def str tree_text(*Expr tree):
    match *tree as node:
        is Num:
            return int_to_str(node.value)
        is Name:
            return node.name
        is Unary:
            return '(' + symbol(node.op) + ' ' + tree_text(node.operand) + ')'
        is Binary:
            return '(' + symbol(node.op) + ' ' + tree_text(node.left) + ' ' + tree_text(node.right) + ')'

def str _instruction_text(Instruction instruction):
    match instruction.opcode as opcode:
        is Push:
            return 'push ' + int_to_str(instruction.operand)
        is Load:
            return 'load ' + instruction.name
        is Store:
            return 'store ' + instruction.name
        is Print:
            return 'print'
        is Apply:
            return 'apply ' + symbol(instruction.operator)
        is ApplyUnary:
            if instruction.operator is Negate:
                return 'negate'
            return 'not'
        is Truth:
            return 'truth'
        is Jump:
            return 'jump ' + int_to_str(instruction.operand)
        is JumpIfFalse:
            return 'jump_if_false ' + int_to_str(instruction.operand)
        is JumpIfTrue:
            return 'jump_if_true ' + int_to_str(instruction.operand)

# One instruction per line, each after its index (what a jump names).
def str code_text([]Instruction code):
    Builder text
    for int i = 0; i < len(code); i += 1:
        text.write(int_to_str(i) + ' ' + _instruction_text(code[i]) + '\n')
    return text.to_str()
