# Trees and instructions as text.
from 'strings' import Builder
from 'parser' import Expr, Num, Name, Unary, Binary
from 'code' import Instruction, Opcode

# A tree with every operation in parentheses, its operator first: `1 + 2 * x` is `(+ 1 (* 2 x))`.
def str tree_text(*Expr tree):
    match *tree as node:
        is Num:
            return format('{}', node.value)
        is Name:
            return node.name
        is Unary:
            return format('({} {})', node.op.symbol(), tree_text(node.operand))
        is Binary:
            return format('({} {} {})', node.op.symbol(), tree_text(node.left), tree_text(node.right))

def str _instruction_text(Instruction instruction):
    match instruction.opcode as opcode:
        is Push:
            return format('push {}', instruction.operand)
        is Load:
            return 'load ' + instruction.name
        is Store:
            return 'store ' + instruction.name
        is Print:
            return 'print'
        is Apply:
            return 'apply ' + instruction.operator.symbol()
        is ApplyUnary:
            if instruction.operator is Negate:
                return 'negate'
            return 'not'
        is Truth:
            return 'truth'
        is Jump:
            return format('jump {}', instruction.operand)
        is JumpIfFalse:
            return format('jump_if_false {}', instruction.operand)
        is JumpIfTrue:
            return format('jump_if_true {}', instruction.operand)

# One instruction per line, each after its index (what a jump names).
def str code_text([]Instruction code):
    Builder text
    for int i = 0; i < len(code); i += 1:
        text.write(format('{} {}\n', i, _instruction_text(code[i])))
    return text.to_str()
