# fetch URL: write the body of an http:// URL to standard output, and its status line to standard error.
from 'std:errors' import Error
from 'std:fmt' import int_to_str
from 'std:http' import get, ResponseResult
from 'std:os' import get_args, write_stderr, write_stdout

def int main(int argc, *byte argv):
    []str args = get_args(argc, argv)
    if len(args) != 2:
        write_stderr('usage: fetch URL\n')
        return 2
    ResponseResult r = get(args[1])
    if r is Error:
        write_stderr('fetch: ' + r.message + '\n')
        return 1
    write_stderr(int_to_str(r.status) + ' ' + r.reason + '\n')
    write_stdout(r.body)
    if r.status >= 400:
        return 1
    return 0
